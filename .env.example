# Copy to .env and fill in TMDB_API_KEY before running the pipeline.
# docker compose up works without a real key; bronze extract will fail until it is set.

# TMDB API v3 key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=replace-me

# Optional extract bounds (also Airflow Variables tmdb_pages / tmdb_max_people)
TMDB_PAGES=5
TMDB_MAX_PEOPLE=200

# Postgres (Airflow metadata db `airflow` + warehouse db `warehouse`)
POSTGRES_USER=tmdb
POSTGRES_PASSWORD=tmdb
POSTGRES_DB=postgres

# Airflow login (http://localhost:8080)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=tmdb-demo-not-secret

# MinIO (S3 API http://localhost:9000, console http://localhost:9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
